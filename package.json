    "pdfjs-dist": "^4.10.38",
    "remarkable-rm": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
